rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && request.resource.data.keys().hasAll(['userId', 'xp', 'level', 'streak', 'createdAt', 'displayName', 'lastActive'])
        && request.resource.data.xp == 0
        && request.resource.data.level == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActive == request.time;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['xp', 'level', 'streak', 'lastActive', 'isPremium', 'dailySessionsUsed', 'lastSessionResetDate', 'displayName'])
        && request.resource.data.lastActive == request.time;
    }

    // Sessions Rules
    match /sessions/{sessionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && isValidId(sessionId);
    }

    // Challenges Rules
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
    }
  }
}
